{
  "name": "teamter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Three.js digital collectible card game inspired by the original Shadowverse (Standard - Wonderland Dreams era). Personal, non-distributed project.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cards:build": "node tools/build-cards.mjs",
    "cards:report": "vite-node tools/report-coverage.ts",
    "sim": "vite-node tools/simulate.ts",
    "art:scan": "node tools/scan-cardart.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@iconify-json/game-icons": "^1.2.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.169.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
