{
  "name": "teamter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Three.js digital collectible card game inspired by the original Shadowverse (Standard - Wonderland Dreams era). Personal, non-distributed project.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
