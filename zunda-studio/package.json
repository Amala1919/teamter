{
  "name": "zunda-studio",
  "private": true,
  "version": "0.0.1",
  "description": "AI chat-driven video editor for synthetic-voice game commentary videos",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:app": "electron-vite build",
    "build:devhost": "vite build -c vite.devhost.config.ts",
    "devhost": "npm run build:app && npm run build:devhost && node out/devhost/main.js",
    "start": "electron-vite preview",
    "postinstall": "install-electron",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:app && npm run build:devhost && playwright test",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "test:electron": "playwright test -c playwright.electron.config.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "7zip-bin": "^5.2.0",
    "ag-psd": "^31.0.2",
    "immer": "^11.1.18",
    "nanoid": "^6.0.1",
    "obs-websocket-js": "^5.0.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
