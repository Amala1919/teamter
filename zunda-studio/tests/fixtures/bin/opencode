#!/usr/bin/env node
// OpenCode CLI の模擬。run / models / --version に応答し、run の引数・入力・エージェント定義を FAKE_LOG に記録する。
import { appendFileSync, existsSync, readFileSync, writeFileSync } from 'node:fs'

const argv = process.argv.slice(2)
const mode = process.env.FAKE_MODE ?? 'text'

if (argv.includes('--version')) {
  process.stdout.write('1.2.3\n')
  process.exit(0)
}

if (argv[0] === 'models') {
  if (mode === 'models-fail') process.exit(1)
  const filter = argv[1]
  const all = ['opencode-go/kimi-k3', 'opencode-go/glm-5.3', 'anthropic/claude-sonnet-5']
  process.stdout.write('Loading models...\n')
  for (const model of all.filter((id) => !filter || id.startsWith(filter + '/'))) process.stdout.write(model + '\n')
  process.exit(0)
}

if (argv[0] !== 'run') {
  process.stderr.write('unsupported command\n')
  process.exit(2)
}

const input = readFileSync(0, 'utf8')
if (process.env.FAKE_LOG) {
  appendFileSync(
    process.env.FAKE_LOG,
    JSON.stringify({
      argv,
      stdin: input,
      cwd: process.cwd(),
      config: process.env.OPENCODE_CONFIG_CONTENT ? JSON.parse(process.env.OPENCODE_CONFIG_CONTENT) : null,
      disableClaudeCode: process.env.OPENCODE_DISABLE_CLAUDE_CODE ?? null
    }) + '\n'
  )
}

const emit = (event) => process.stdout.write(JSON.stringify({ timestamp: Date.now(), sessionID: 'ses_fake', ...event }) + '\n')

function nextSequenceItem() {
  const sequence = JSON.parse(process.env.FAKE_SEQUENCE ?? '[]')
  const counterFile = process.env.FAKE_COUNTER
  const count = counterFile && existsSync(counterFile) ? Number(readFileSync(counterFile, 'utf8')) : 0
  if (counterFile) writeFileSync(counterFile, String(count + 1))
  return sequence[Math.min(count, sequence.length - 1)]
}

const text = (value) => emit({ type: 'text', part: { type: 'text', text: value, time: { start: 1, end: 2 } } })

emit({ type: 'step_start', part: { type: 'step-start' } })
switch (mode) {
  case 'text':
    text(process.env.FAKE_REPLY ?? '了解したわ')
    break
  case 'json-with-prose':
    text('はい、こちらです。\n```json\n' + (process.env.FAKE_STRUCTURED ?? '{}') + '\n```')
    break
  case 'sequence':
    text(JSON.stringify(nextSequenceItem()))
    break
  case 'auth-error':
    emit({ type: 'error', error: { name: 'ProviderAuthError', data: { message: 'Unauthorized: invalid API key' } } })
    process.exit(1)
    break
  default:
    process.stderr.write(`unknown FAKE_MODE ${mode}\n`)
    process.exit(2)
}
emit({ type: 'step_finish', part: { type: 'step-finish' } })
